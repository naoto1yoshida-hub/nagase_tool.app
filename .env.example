# ============================================================
# Nagase Tool 環境変数サンプル
# 使い方: 本ファイルをプロジェクトルートに `.env` としてコピーし、
#         実値を記入してください。
#   Windows:  copy .env.example ..\.env
#   macOS/Linux:  cp .env.example ../.env
# ============================================================

# ── アプリ認証 ──
# 社内チーム共有パスワード。ナガセ社内の指定メンバーのみに配布すること。
# 値は十分なランダム性（英数記号を含む 16 文字以上推奨）にしてください。
APP_PASSWORD=your_password_here

# ── OpenAI API（議事録生成等で使用） ──
OPENAI_API_KEY=

# ── 図面 / 工程フォルダのパス（相対パスは src/ 起点） ──
DRAWING_DIR=図面一覧
PROCESS_DIR=工程一覧

# ── 検索重み（合計 1.0 推奨） ──
WEIGHT_CONTOUR=0.30
WEIGHT_CLIP=0.35
WEIGHT_SIFT=0.25
WEIGHT_ATTR=0.10

# ── 検索結果件数 ──
FAISS_TOP_K=50
DISPLAY_TOP_K=10

# ── サムネイル ──
THUMB_MAX_WIDTH=400
THUMB_QUALITY=85

# ── CLIP モデル ──
CLIP_MODEL_NAME=clip-ViT-B-32

# ── SIFT ──
SIFT_MATCH_RATIO=0.75

# ── ログ ──
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7
